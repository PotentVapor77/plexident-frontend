# Copia este archivo como .env y ajusta los valores.
#  cp .env.example .env

# ============================================================================
# FRONTEND (Vite)
# ============================================================================

# URL base de la API de Django a la que apunta el frontend.
#  - Relativa ("/api")    -> el proxy del servidor (Vite/nginx) reenvía a la API.
#  - Absoluta             -> apunta directo al backend (http://localhost:8000/api).
# Default en código: http://localhost:8000/api
VITE_API_BASE_URL=/api
